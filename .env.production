# ╔════════════════════════════════════════════════╗
# ║   POS Abadi Jaya — VPS Production Config      ║
# ║   Copy this file to .env before deployment     ║
# ╚════════════════════════════════════════════════╝

# ──── Database ────
DB_NAME=pos_abadi
DB_PASS=GANTI_PASSWORD_INI_SEKARANG

# ──── Security ────
# WAJIB DIGANTI! Gunakan: openssl rand -hex 32
JWT_SECRET=GANTI_JWT_SECRET_INI_SEKARANG

# ──── Firebase (Optional) ────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ──── Telegram Bot (Optional) ────
TELEGRAM_BOT_TOKEN=

# ──── Domain (untuk SSL) ────
# DOMAIN=pos.abadijaya.com
